# PostgreSQL Database Connection URL
# Replace with your PostgreSQL host, port, user, password, and database name
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jeevan_chetna_db?schema=public"

# Admin Authentication Secret for JWT session cookies
# Generate a strong 32+ character random string for production
JWT_SECRET="replace-with-a-secure-random-secret-key-32-chars-minimum"

# Seed Admin Credentials (used only during initial `npx prisma db seed`)
ADMIN_EMAIL="admin@jeevanchetna.org"
ADMIN_PASSWORD="ChangeMe@2025Secure"
ADMIN_NAME="Portal Administrator"

# Application Environment
NODE_ENV="development"
